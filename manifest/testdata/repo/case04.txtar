<manifest>
  <project name="platform/example/p0" path="ex/p0" groups="notdefault" />
  <project name="platform/example/p3" path="ex/p3" revision="rev-b" remote="other" />
  <project name="platform/example/p5" path="ex/p5" revision="rev-a" groups="pdk" />
  <include name="inc2.xml" groups="inc2g,pdk" />
  <project name="platform/example/multi" path="ex/multi0" remote="partner" />
  <remove-project name="platform/example/p1" />
</manifest>
