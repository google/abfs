Expected projects from git-repo v2.72 (3656290): repo init -u <manifest repository of
these files> -b main -m default.xml -g all, then repo manifest -o -, with the omitted values
filled back in (path: the name; revision: the remote's, else the default's; remote, upstream
and dest-branch: the default's). Groups leave out all, name: and path:. Columns: path, name,
revision, remote, groups, upstream, dest-branch. want-error holds the start of repo's error.
-- default.xml --
<manifest>
  <remote name="aosp" fetch=".." />
  <remote name="partner" fetch="https://partner.example.com" revision="partner-rev" />
  <remote name="other" fetch="https://other.example.com" revision="other-rev" />
  <default remote="aosp" revision="main" />
  <include name="inc1.xml" />
  <project name="platform/example/p2" path="ex/p2" remote="partner" />
  <project name="platform/example/p3" path="ex/p3" revision="rev-a" />
  <extend-project name="platform/example/p0" revision="v1"></extend-project>
  <extend-project name="platform/example/p0" path="ex/multi1" revision="v1" base-rev="inc-rev" dest-path="ex/moved0" upstream="up1"></extend-project>
  <remove-project name="platform/example/multi" path="ex/p4" optional="true" base-rev="main" />
  <extend-project name="platform/example/p1" path="ex/p3" remote="partner"></extend-project>
</manifest>
-- inc1.xml --
<manifest>
  <include name="inc2.xml" />
  <project name="platform/example/p4" path="ex/p4" remote="partner" />
  <project name="platform/example/multi" path="ex/multi2" revision="rev-a" groups="a,b" />
  <extend-project name="platform/example/p0" path="ex/multi0" revision="v1" groups="x, y"></extend-project>
</manifest>
