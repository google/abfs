<manifest>
  <include name="inc3.xml" groups="inc1g" revision="inc-rev" />
  <project name="platform/example/p0" path="ex/p0" revision="rev-b" remote="partner" groups="notdefault" />
  <project name="platform/example/p5" path="ex/p5" remote="partner" groups="notdefault" />
</manifest>
