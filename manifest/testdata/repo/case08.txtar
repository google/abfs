Expected projects from git-repo v2.72 (3656290): repo init -u <manifest repository of
these files> -b main -m default.xml -g all, then repo manifest -o -, with the omitted values
filled back in (path: the name; revision: the remote's, else the default's; remote, upstream
and dest-branch: the default's). Groups leave out all, name: and path:. Columns: path, name,
revision, remote, groups, upstream, dest-branch. want-error holds the start of repo's error.
-- default.xml --
<manifest>
  <remote name="aosp" fetch=".." />
  <remote name="partner" fetch="https://partner.example.com" revision="partner-rev" />
  <remote name="other" fetch="https://other.example.com" revision="other-rev" />
  <default remote="aosp" revision="main" />
  <project name="platform/example/p2" path="ex/p2" />
  <include name="inc1.xml" revision="inc-rev" />
  <project name="platform/example/p3" path="ex/p3" groups="notdefault" />
  <project name="platform/example/p5" path="ex/p5" revision="rev-b" remote="other" groups="pdk" />
  <remove-project name="platform/example/multi" />
  <extend-project name="platform/example/p0" path="ex/multi2" base-rev="rev-b" remote="aosp"></extend-project>
</manifest>
-- inc1.xml --
<manifest>
  <project name="platform/example/p0" path="ex/p0" remote="partner" groups="pdk" />
  <project name="platform/example/p4" path="ex/p4" remote="partner" groups="pdk" />
  <project name="platform/example/multi" path="ex/multi0" revision="rev-b" />
  <include name="inc2.xml" groups="x y" revision="inc-rev" />
  <extend-project name="platform/example/p1" path="ex/multi1" groups="ext"></extend-project>
</manifest>
-- inc2.xml --
<manifest>
  <include name="inc3.xml" revision="inc-rev" />
  <project name="platform/example/multi" path="ex/multi1" revision="rev-a" groups="c d" />
  <remove-project path="ex/new0" optional="true" />
  <extend-project name="platform/example/p1" path="ex/p4" revision="v1" groups="x, y"></extend-project>
</manifest>
-- inc3.xml --
<manifest>
  <project name="platform/example/p1" path="ex/p1" revision="rev-b" />
  <project name="platform/example/multi" path="ex/multi2" />
  <remove-project path="ex/p0" optional="true" />
</manifest>
-- want --
ex/p1	platform/example/p1	rev-b	aosp	x,y		
ex/p2	platform/example/p2	main	aosp			
ex/p3	platform/example/p3	main	aosp	notdefault		
ex/p4	platform/example/p4	inc-rev	partner	pdk		
