Expected projects from git-repo v2.72 (3656290): repo init -u <manifest repository of
these files> -b main -m default.xml -g all, then repo manifest -o -, with the omitted values
filled back in (path: the name; revision: the remote's, else the default's; remote, upstream
and dest-branch: the default's). Groups leave out all, name: and path:. Columns: path, name,
revision, remote, groups, upstream, dest-branch. want-error holds the start of repo's error.
-- default.xml --
<manifest>
  <remote name="aosp" fetch=".." />
  <remote name="partner" fetch="https://partner.example.com" revision="partner-rev" />
  <remote name="other" fetch="https://other.example.com" revision="other-rev" />
  <default remote="aosp" revision="main" />
  <include name="inc1.xml" groups="x y" />
  <project name="platform/example/p0" path="ex/p0" revision="rev-a" groups="c d" />
  <project name="platform/example/p1" path="ex/p1" groups="a,b" />
  <project name="platform/example/multi" path="ex/multi2" revision="rev-a" />
  <remove-project path="ex/p3" />
</manifest>
-- inc1.xml --
<manifest>
  <project name="platform/example/multi" path="ex/multi0" remote="partner" />
  <include name="inc2.xml" groups="inc1g" revision="inc-rev" />
  <project name="platform/example/multi" path="ex/multi1" groups="a,b" />
  <extend-project name="platform/example/p0" groups="ext" remote="aosp" dest-path="ex/moved1"></extend-project>
</manifest>
-- inc2.xml --
<manifest>
  <project name="platform/example/p3" path="ex/p3" revision="rev-b" />
  <include name="inc3.xml" />
  <project name="platform/example/p4" path="ex/p4" />
</manifest>
-- inc3.xml --
<manifest>
  <project name="platform/example/p2" path="ex/p2" groups="a,b" />
  <project name="platform/example/p5" path="ex/p5" revision="rev-b" remote="partner" groups="pdk" />
  <remove-project />
</manifest>
-- want-error --
remove-project must have name
