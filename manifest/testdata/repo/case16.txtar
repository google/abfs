Expected projects from git-repo v2.72 (3656290): repo init -u <manifest repository of
these files> -b main -m default.xml -g all, then repo manifest -o -, with the omitted values
filled back in (path: the name; revision: the remote's, else the default's; remote, upstream
and dest-branch: the default's). Groups leave out all, name: and path:. Columns: path, name,
revision, remote, groups, upstream, dest-branch. want-error holds the start of repo's error.
-- default.xml --
<manifest>
  <remote name="aosp" fetch=".." />
  <remote name="partner" fetch="https://partner.example.com" revision="partner-rev" />
  <remote name="other" fetch="https://other.example.com" revision="other-rev" />
  <default remote="aosp" revision="main" />
  <project name="platform/example/p0" path="ex/p0" revision="rev-a" groups="notdefault" />
  <include name="inc1.xml" />
  <remove-project path="ex/p4" optional="true" />
  <extend-project name="platform/example/p3" base-rev="inc-rev"></extend-project>
</manifest>
-- inc1.xml --
<manifest>
  <include name="inc2.xml" groups="x y" />
  <project name="platform/example/p5" path="ex/p5" />
  <project name="platform/example/multi" path="ex/multi0" revision="rev-b" />
  <remove-project />
  <extend-project name="platform/example/p2" path="ex/p3" revision="v2" groups="x, y" dest-path="ex/moved0"></extend-project>
</manifest>
-- inc2.xml --
<manifest>
  <project name="platform/example/p3" path="ex/p3" remote="partner" />
  <project name="platform/example/p4" path="ex/p4" revision="rev-b" groups="notdefault" />
  <include name="inc3.xml" />
  <extend-project name="platform/example/p3" revision="v1" remote="other" dest-branch="main"></extend-project>
</manifest>
-- inc3.xml --
<manifest>
  <project name="platform/example/p1" path="ex/p1" remote="other" />
  <project name="platform/example/p2" path="ex/p2" revision="rev-b" />
  <project name="platform/example/multi" path="ex/multi1" />
  <project name="platform/example/multi" path="ex/multi2" />
  <extend-project name="platform/example/p2" path="ex/p1" revision="v2" base-rev="inc-rev" groups="ext" remote="other" upstream="main"></extend-project>
</manifest>
-- want-error --
remove-project must have name
