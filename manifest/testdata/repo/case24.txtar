Expected projects from git-repo v2.72 (3656290): repo init -u <manifest repository of
these files> -b main -m default.xml -g all, then repo manifest -o -, with the omitted values
filled back in (path: the name; revision: the remote's, else the default's; remote, upstream
and dest-branch: the default's). Groups leave out all, name: and path:. Columns: path, name,
revision, remote, groups, upstream, dest-branch. want-error holds the start of repo's error.
-- default.xml --
<manifest>
  <remote name="aosp" fetch=".." />
  <remote name="partner" fetch="https://partner.example.com" revision="partner-rev" />
  <remote name="other" fetch="https://other.example.com" revision="other-rev" />
  <default remote="aosp" revision="main" upstream="main-up" />
  <project name="platform/example/p1" path="ex/p1" revision="rev-b" remote="partner" groups="notdefault" />
  <include name="inc1.xml" groups="x y" />
  <project name="platform/example/p5" path="ex/p5" />
  <remove-project name="platform/example/unknown" />
</manifest>
-- inc1.xml --
<manifest>
  <project name="platform/example/p3" path="ex/p3" revision="rev-a" remote="other" groups="pdk" />
  <project name="platform/example/p4" path="ex/p4" />
  <include name="inc2.xml" groups="inc2g,pdk" />
  <project name="platform/example/multi" path="ex/multi0" revision="rev-a" remote="partner" groups="a,b" />
  <project name="platform/example/multi" path="ex/multi1" />
  <project name="platform/example/multi" path="ex/multi2" revision="rev-b" remote="other" />
  <extend-project name="platform/example/p4" path="ex/p0" revision="v2" groups="x, y"><copyfile src="a" dest="b-40" /></extend-project>
</manifest>
-- inc2.xml --
<manifest>
  <project name="platform/example/p0" path="ex/p0" />
  <extend-project name="platform/example/p1" revision="v2" groups="ext" remote="nowhere"><copyfile src="a" dest="b-16" /></extend-project>
  <extend-project name="platform/example/p1" path="ex/p3" revision="v2" groups="x, y" dest-path="ex/moved0"></extend-project>
  <include name="inc3.xml" revision="inc-rev" />
  <project name="platform/example/p4" path="ex/multi2" revision="rev-b" remote="other" />
</manifest>
-- inc3.xml --
<manifest>
  <project name="platform/example/p2" path="ex/p2" revision="rev-b" />
  <remove-project name="platform/example/p2" />
</manifest>
