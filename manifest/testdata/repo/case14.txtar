Expected projects from git-repo v2.72 (3656290): repo init -u <manifest repository of
these files> -b main -m default.xml -g all, then repo manifest -o -, with the omitted values
filled back in (path: the name; revision: the remote's, else the default's; remote, upstream
and dest-branch: the default's). Groups leave out all, name: and path:. Columns: path, name,
revision, remote, groups, upstream, dest-branch. want-error holds the start of repo's error.
-- default.xml --
<manifest>
  <remote name="aosp" fetch=".." />
  <remote name="partner" fetch="https://partner.example.com" revision="partner-rev" />
  <remote name="other" fetch="https://other.example.com" revision="other-rev" />
  <default remote="aosp" revision="main" upstream="main-up" />
  <project name="platform/example/p4" path="ex/p4" revision="rev-a" />
  <include name="inc1.xml" groups="x y" revision="inc-rev" />
  <project name="platform/example/multi" path="ex/multi0" remote="partner" />
</manifest>
-- inc1.xml --
<manifest>
  <project name="platform/example/p1" path="ex/p1" />
  <include name="inc2.xml" groups="inc1g" />
  <project name="platform/example/p2" path="ex/p2" revision="rev-a" groups="c d" />
</manifest>
-- inc2.xml --
<manifest>
  <project name="platform/example/p3" path="ex/p3" groups="c d" />
  <project name="platform/example/multi" path="ex/multi1" revision="rev-a" />
  <extend-project name="platform/example/p4" upstream="up1" dest-branch="db1"></extend-project>
  <include name="inc3.xml" groups="inc1g" />
</manifest>
-- inc3.xml --
<manifest>
  <project name="platform/example/p0" path="ex/p0" />
  <project name="platform/example/p5" path="ex/p5" remote="partner" />
  <extend-project name="platform/example/p4"></extend-project>
  <extend-project name="platform/example/p4" revision="v1" base-rev="other-rev"></extend-project>
</manifest>
