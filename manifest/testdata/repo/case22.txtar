Expected projects from git-repo v2.72 (3656290): repo init -u <manifest repository of
these files> -b main -m default.xml -g all, then repo manifest -o -, with the omitted values
filled back in (path: the name; revision: the remote's, else the default's; remote, upstream
and dest-branch: the default's). Groups leave out all, name: and path:. Columns: path, name,
revision, remote, groups, upstream, dest-branch. want-error holds the start of repo's error.
-- default.xml --
<manifest>
  <remote name="aosp" fetch=".." />
  <remote name="partner" fetch="https://partner.example.com" revision="partner-rev" />
  <remote name="other" fetch="https://other.example.com" revision="other-rev" />
  <default remote="aosp" revision="main" />
  <project name="platform/example/p2" path="ex/p2" groups="notdefault" />
  <include name="inc1.xml" />
  <project name="platform/example/p5" path="ex/p5" revision="rev-b" groups="c d" />
  <project name="platform/example/p2" path="ex/none" remote="other" />
</manifest>
-- inc1.xml --
<manifest>
  <project name="platform/example/p4" path="ex/p4" revision="rev-b" />
  <include name="inc2.xml" groups="inc1g" />
  <extend-project name="platform/example/multi" revision="v1" remote="partner" dest-path="ex/p1" dest-branch="main"></extend-project>
  <remove-project name="platform/example/p0" path="ex/multi1" optional="true" base-rev="rev-a" />
</manifest>
-- inc2.xml --
<manifest>
  <project name="platform/example/p3" path="ex/p3" revision="rev-a" remote="partner" />
  <extend-project name="platform/example/p3" revision="v1" upstream="main"></extend-project>
  <include name="inc3.xml" groups="x y" />
</manifest>
-- inc3.xml --
<manifest>
  <project name="platform/example/p0" path="ex/p0" />
  <project name="platform/example/p1" path="ex/p1" revision="rev-b" groups="c d" />
  <project name="platform/example/multi" path="ex/multi0" revision="rev-b" />
  <project name="platform/example/multi" path="ex/multi1" />
  <remove-project name="platform/example/p4" />
</manifest>
-- want-error --
dest-path when matching multiple
