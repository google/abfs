Expected projects from git-repo v2.72 (3656290): repo init -u <manifest repository of
these files> -b main -m default.xml -g all, then repo manifest -o -, with the omitted values
filled back in (path: the name; revision: the remote's, else the default's; remote, upstream
and dest-branch: the default's). Groups leave out all, name: and path:. Columns: path, name,
revision, remote, groups, upstream, dest-branch. want-error holds the start of repo's error.
-- default.xml --
<manifest>
  <remote name="aosp" fetch=".." />
  <remote name="partner" fetch="https://partner.example.com" revision="partner-rev" />
  <remote name="other" fetch="https://other.example.com" revision="other-rev" />
  <default remote="aosp" revision="main" />
  <project name="platform/example/p1" path="ex/p1" revision="rev-a" groups="c d" />
  <project name="platform/example/p2" path="ex/p2" />
  <project name="platform/example/multi" path="ex/multi1" groups="a,b" />
  <remove-project name="platform/example/p0" optional="true" />
  <extend-project name="platform/example/p5" path="ex/p0" revision="v2" base-rev="main" groups="x, y" upstream="main" dest-branch="db1"></extend-project>
  <include name="inc1.xml" groups="inc1g" />
  <remove-project path="ex/new0" />
</manifest>
-- inc1.xml --
<manifest>
  <project name="platform/example/p0" path="ex/p0" revision="rev-a" />
  <project name="platform/example/p4" path="ex/p4" />
  <project name="platform/example/multi" path="ex/multi0" />
  <project name="platform/example/multi" path="ex/multi2" revision="rev-b" />
  <extend-project name="platform/example/p0" revision="v2" base-rev="main"></extend-project>
  <extend-project name="platform/example/p2" revision="v2" base-rev="main" dest-path="ex/moved0"></extend-project>
  <include name="inc2.xml" groups="inc1g" />
  <extend-project name="platform/example/p0" base-rev="inc-rev" groups="pdk z" dest-path="ex/moved0"></extend-project>
</manifest>
-- inc2.xml --
<manifest>
  <include name="inc3.xml" groups="inc2g,pdk" />
  <project name="platform/example/p5" path="ex/p5" />
</manifest>
-- inc3.xml --
<manifest>
  <project name="platform/example/p3" path="ex/p3" revision="rev-a" />
</manifest>
-- want-error --
extend-project element specifies non-existent
