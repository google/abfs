  <extend-project name="platform/example/p3" path="ex/new1" base-rev="inc-rev" groups="pdk z"><copyfile src="a" dest="b-59" /></extend-project>
  <extend-project name="platform/example/p2" path="ex/p2" revision="v2" upstream="main"></extend-project>
  <remove-project name="platform/example/multi" path="ex/p0" optional="true" />
</manifest>
