name: "go-git"
description:
    "Git hash and file mode helpers from go-git, a Git implementation in "
    "pure Go. ABFS uses them to implement its Hash and FileMode entity "
    "types."

third_party {
  identifier {
    type: "Git"
    value: "https://github.com/go-git/go-git"
    primary_source: true
    version: "302dddeda962e4bb3477a8e4080bc6f5a253e2bb"
  }
  version: "v5.12.0"
  last_upgrade_date { year: 2026 month: 10 day: 3 }
  license_type: NOTICE
  local_modifications:
      "Only a subset of three upstream files is kept, with code and comments "
      "otherwise unchanged: plumbing/hash/hash_sha1.go keeps the Size and "
      "HexSize constants (CryptoType and the !sha256 build constraint are "
      "dropped); plumbing/hash.go keeps Hash, ZeroHash, NewHash, IsZero, "
      "String and IsHash (ComputeHash, Hasher and HashSlice are dropped); "
      "plumbing/filemode/filemode.go keeps FileMode, its constants, New, "
      "String and ToOSFileMode (the other functions and methods are "
      "dropped). Import paths are rewritten to this module and a short "
      "copyright/SPDX header is added to each file. plumbing/sha256.go is "
      "a Google modification of the plumbing/hash.go helpers for 32-byte "
      "SHA-256 hashes (SHA256, ZeroSHA256, NewSHA256, IsZero, String, "
      "IsSHA256)."
}
