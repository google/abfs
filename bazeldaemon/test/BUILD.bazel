load(":symlink.bzl", "ln_symlink_rule")
load(":directory.bzl", "directory_rule", "create_directory_rule")

directory_rule(
    name = "dir1"
)

ln_symlink_rule(
    name = "ln_symlink",
    target_file = "hello.txt",
)

genrule(
    name = "use_symlink",
    srcs = ["ln_symlink"],
    # srcs = ["link_created_by_ln.txt"],
    outs = ["hello.out"],
    cmd = "readlink -v $(location :ln_symlink)> $@",
)

create_directory_rule(
    name = "dir4"
)

genrule(
    name = "use_create_directory_rule",
    srcs = [":dir4"],
    # outs = ["dir4/bar.txt"],
    # cmd = "touch {}/bar.txt".format("$(location :dir4)"),
    outs = ["bar.txt"],
    cmd = "stat {}/.config >$@".format("$(location :dir4)"),
)

