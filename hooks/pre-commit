set -e

# We only care about Go files.
GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | (grep -e "\.go" || true))

# Nothing to do.
if [[ -z "$GO_FILES" ]]; then
  exit 0
fi

do_goimports(){
  if ! command -v "goimports" > /dev/null; then
    echo -e "\e[33mWARNING: goimports isn't installed. pre-commit step is skipped.\e[0m"
    return
  fi

  local FILES=("$@")

  if ! echo "${FILES[@]}" | xargs goimports -w -local "github.com/google/abfs"; then
    echo ""
    echo ""
    echo "pre_commit: could not format files"
    exit 1
  fi

  echo "${FILES[@]}" | xargs git add
}

do_golangci-lint(){
  if ! command -v "golangci-lint" > /dev/null; then
    echo -e "\e[33mWARNING: golangci-lint isn't installed. pre-commit step is skipped. \
Install with 'go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest'\e[0m"
    return
  fi

  if ! golangci-lint run &> lint_report.txt; then
    echo -e "\e[33mLint failures detected, but aren't blocking commit. See report in lint_report.txt\e[0m"
  fi
}

echo -e "\e[33m[pre-commit]Starting pre-commit hooks...\e[0m"
do_goimports "${GO_FILES[@]}"
do_golangci-lint
